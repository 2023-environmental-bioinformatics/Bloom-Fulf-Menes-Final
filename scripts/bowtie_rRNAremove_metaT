#bin/bash

#I downloaded the LSU and SSU files  they are fasta files from archive release 111 (as per the paper

##Step 1
##first upzip silva files

#upzip LSU 
tar -xzf /vortexfs1/omics/env-bio/collaboration/Bloom-Fulf-Menes-Final/output/silva/LSURef_111_tax_silva.fasta.tgz

#unzip SSU
tar -xzf /vortexfs1/omics/env-bio/collaboration/Bloom-Fulf-Menes-Final/output/silva/SSURef_111_tax_silva.fasta.tgz

##Step 2
## index both the SILVA LSU and SSU rRNA sequences to create separate indices for each database
bowtie2-build /vortexfs1/omics/env-bio/collaboration/Bloom-Fulf-Menes-Final/output/silva/LSURef_111_tax_silva.fasta silva_lsu_rRNA_index

bowtie2-build /vortexfs1/omics/env-bio/collaboration/Bloom-Fulf-Menes-Final/output/silva/SSURef_111_tax_silva.fasta silva_ssu_rRNA_index

#the output files are Output files: 
#"silva_lsu_rRNA_index.*.bt2" and "silva_ssu_rRNA_index.*.bt2"

##Step 3
##Align metatranscriptome reads to both SILVA LSU and SSU rRNA databases

#the metatranscriptome reads are aligned to the SILVA LSU rRNA database, and the unaligned reads are saved to unaligned_lsu_reads.fastq.

# The -f flag tells bowtie that I have fasta files (not fastq files). The -x refers to the base name of the indices created by bowtie2-build. -U is for fasta files that are unpaired, and ours are already merged. -S write SAM alignments (one of the outputs of the code). --un where to save the unpaired reads that fail to align (the other output of the code).

#Align to SILVA LSU rRNA database for each sample separately

bowtie2 -f -x silva_lsu_rRNA_index -U ../output/filtered/FS851_metaT_FILTERED -S aligned_lsu_FS851.sam --un unaligned_lsu_reads_FS851.fasta
# OUTPUT: 
# 7446523 reads; of these:
#   7446523 (100.00%) were unpaired; of these:
#     7446185 (100.00%) aligned 0 times
#     338 (0.00%) aligned exactly 1 time
#    0 (0.00%) aligned >1 times
# 0.00% overall alignment rate (this is bowtie rounding down)

bowtie2 -f -x silva_lsu_rRNA_index -U ../output/filtered/FS852_metaT_FILTERED -S aligned_lsu_FS852.sam --un unaligned_lsu_reads_FS852.fasta
# OUTPUT:
#  23137842 (100.00%) were unpaired; of these:
#    23137839 (100.00%) aligned 0 times
#    2 (0.00%) aligned exactly 1 time
#    1 (0.00%) aligned >1 times
# 0.00% overall alignment rate

bowtie2 -f -x silva_lsu_rRNA_index -U ../output/filtered/FS854_metaT_FILTERED -S aligned_lsu_FS854.sam --un unaligned_lsu_reads_FS854.fasta
# OUTPUT: 
# 7840862 (100.00%) were unpaired; of these:
#     7840862 (100.00%) aligned 0 times
#     0 (0.00%) aligned exactly 1 time
#     0 (0.00%) aligned >1 times
# 0.00% overall alignment rate

bowtie2 -f -x silva_lsu_rRNA_index -U ../output/filtered/FS856_metaT_FILTERED -S aligned_lsu_FS856.sam --un unaligned_lsu_reads_FS856.fasta
# OUTPUT: 
#   10303693 (100.00%) were unpaired; of these:
#     10303693 (100.00%) aligned 0 times
#     0 (0.00%) aligned exactly 1 time
#     0 (0.00%) aligned >1 times
# 0.00% overall alignment rate

# Align the remaining unaligned reads to SILVA SSU rRNA database
bowtie2 -f -x silva_ssu_rRNA_index -U unaligned_lsu_reads_FS851.fasta -S aligned_ssu_FS851.sam --un unaligned_SSUandLSU_reads_FS851.fasta
# OUTPUT: 
# 7446185 reads; of these:
#   7446185 (100.00%) were unpaired; of these:
#     7446184 (100.00%) aligned 0 times
#     1 (0.00%) aligned exactly 1 time
#     0 (0.00%) aligned >1 times
# 0.00% overall alignment rate

bowtie2 -f -x silva_ssu_rRNA_index -U unaligned_lsu_reads_FS852.fasta -S aligned_ssu_FS852.sam --un unaligned_SSUandLSU_reads_FS852.fasta
# OUTPUT: 
#   23137839 (100.00%) were unpaired; of these:
#     23137839 (100.00%) aligned 0 times
#     0 (0.00%) aligned exactly 1 time
#     0 (0.00%) aligned >1 times
# 0.00% overall alignment rate

bowtie2 -f -x silva_ssu_rRNA_index -U unaligned_lsu_reads_FS854.fasta -S aligned_ssu_FS854.sam --un unaligned_SSUandLSU_reads_FS854.fasta
# OUTPUT: 
# 7840862 (100.00%) were unpaired; of these:
#     7840862 (100.00%) aligned 0 times
#     0 (0.00%) aligned exactly 1 time
#     0 (0.00%) aligned >1 times
# 0.00% overall alignment rate

bowtie2 -f -x silva_ssu_rRNA_index -U unaligned_lsu_reads_FS856.fasta -S aligned_ssu_FS856.sam --un unaligned_SSUandLSU_reads_FS856.fasta
# OUTPUT: 
#   10303693 (100.00%) were unpaired; of these:
#     10303693 (100.00%) aligned 0 times
#     0 (0.00%) aligned exactly 1 time
#     0 (0.00%) aligned >1 times
# 0.00% overall alignment rate


